<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default CorelDRAW 2020 Dark Theme Palette (swapped dynamically for Black/Medium/Light) -->
    <SolidColorBrush x:Key="CorelBgBrush" Color="#2B2B2E"/>
    <SolidColorBrush x:Key="CorelSurfaceBrush" Color="#333337"/>
    <SolidColorBrush x:Key="CorelHeaderBrush" Color="#3A3A3F"/>
    <SolidColorBrush x:Key="CorelHeaderHoverBrush" Color="#45454B"/>
    <SolidColorBrush x:Key="CorelInputBgBrush" Color="#1F1F22"/>
    <SolidColorBrush x:Key="CorelBorderBrush" Color="#4A4A50"/>
    <SolidColorBrush x:Key="CorelDividerBrush" Color="#3E3E43"/>
    <SolidColorBrush x:Key="CorelTextBrush" Color="#E6E6EA"/>
    <SolidColorBrush x:Key="CorelMutedTextBrush" Color="#A6A6B0"/>
    <SolidColorBrush x:Key="CorelButtonBgBrush" Color="#3F3F45"/>
    <SolidColorBrush x:Key="CorelButtonHoverBrush" Color="#4D4D54"/>
    <SolidColorBrush x:Key="CorelButtonPressedBrush" Color="#2F2F34"/>
    <SolidColorBrush x:Key="CorelAccentBrush" Color="#2D7BD6"/>
    <SolidColorBrush x:Key="CorelAccentHoverBrush" Color="#3C8BE8"/>
    <SolidColorBrush x:Key="CorelAccentPressedBrush" Color="#2264B2"/>
    <SolidColorBrush x:Key="CorelDangerBrush" Color="#A83232"/>
    <SolidColorBrush x:Key="CorelDangerHoverBrush" Color="#C23C3C"/>
    <SolidColorBrush x:Key="CorelDangerPressedBrush" Color="#8A2626"/>
    <SolidColorBrush x:Key="CorelCyanBrush" Color="#178F9C"/>
    <SolidColorBrush x:Key="CorelCyanHoverBrush" Color="#1FA6B5"/>
    <SolidColorBrush x:Key="CorelStatusBgBrush" Color="#232326"/>

    <!-- Typography Defaults -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CorelMutedTextBrush}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SubGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CorelMutedTextBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,6,0,4"/>
    </Style>

    <!-- Flat Corel Button -->
    <Style x:Key="CorelButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CorelButtonBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CorelButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CorelButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Button -->
    <Style x:Key="CorelPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CorelButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource CorelAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorelAccentBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CorelAccentHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CorelAccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CorelAccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger / Delete Button -->
    <Style x:Key="CorelDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CorelButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource CorelDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorelDangerBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CorelDangerHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CorelDangerHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CorelDangerPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick Navigation Pill Button -->
    <Style x:Key="NavPillButtonStyle" TargetType="Button" BasedOn="{StaticResource CorelButtonStyle}">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,0,3,3"/>
    </Style>

    <!-- Corel Flat TextBox -->
    <Style x:Key="CorelTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource CorelInputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="1,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CorelAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Corel Flat ComboBox -->
    <Style x:Key="CorelComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource CorelInputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="5,1,20,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{DynamicResource CorelInputBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource CorelAccentBrush}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource CorelInputBgBrush}"
                                            BorderBrush="{DynamicResource CorelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="{DynamicResource CorelMutedTextBrush}"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CorelAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="6,0,20,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{DynamicResource CorelInputBgBrush}"
                                        BorderBrush="{DynamicResource CorelBorderBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Corel CheckBox -->
    <Style x:Key="CorelCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Width="14" Height="14"
                                Background="{DynamicResource CorelInputBgBrush}"
                                BorderBrush="{DynamicResource CorelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark"
                                  Data="M 2 6 L 5 9 L 10 3"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.8"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CorelAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CorelAccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Corel RadioButton -->
    <Style x:Key="CorelRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Outer"
                                     Fill="{DynamicResource CorelInputBgBrush}"
                                     Stroke="{DynamicResource CorelBorderBrush}"
                                     StrokeThickness="1"/>
                            <Ellipse x:Name="Inner"
                                     Width="6" Height="6"
                                     Fill="{DynamicResource CorelAccentBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource CorelAccentBrush}"/>
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native CorelDRAW Accordion Expander (Matches Caractere / Parágrafo panels) -->
    <Style x:Key="CorelExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource CorelTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CorelSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorelDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBd"
                                                Background="{DynamicResource CorelHeaderBrush}"
                                                BorderBrush="{DynamicResource CorelDividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Fill="{DynamicResource CorelMutedTextBrush}"
                                                      Data="M 0 0 L 5 4 L 0 8 Z"/>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.FontSize="11.5"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.Foreground="{DynamicResource CorelTextBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource CorelHeaderHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0 1 L 8 1 L 4 6 Z"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource CorelAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <Border x:Name="ExpandSite"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource CorelBgBrush}"
                                    Padding="9,8,9,10">
                                <ContentPresenter/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sleek Dark CorelDRAW ScrollBar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9"/>
        <Setter Property="MinWidth" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource CorelStatusBgBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd"
                                                    Background="{DynamicResource CorelBorderBrush}"
                                                    CornerRadius="3"
                                                    Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource CorelMutedTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource CorelAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
